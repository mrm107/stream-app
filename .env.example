# Frontend env. Copy to `.env` and adjust. All Vite vars must be VITE_-prefixed.
# Vars are read in src/util/constant.ts (browser) and vite.config.ts (proxy).

# --- Browser-facing base paths (what the app fetches) ------------------------
# Defaults are the same-origin Vite proxies below, so no CORS in dev.
VITE_API_BASE=/api
VITE_HLS_BASE=/hls

# RTMP "Server" field shown to broadcasters for OBS.
VITE_RTMP_URL=rtmp://89.42.136.84/live

# --- Dev proxy targets (used only by vite.config.ts, not shipped to browser) -
# Where the /api and /hls paths above are forwarded during `vite dev`.
VITE_API_TARGET=http://localhost:8080
VITE_HLS_TARGET=http://89.42.136.84:8085/live
